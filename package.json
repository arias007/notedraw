{
  "name": "notedraw",
  "version": "3.4.72",
  "description": "Draw and edit directly on notes with an open API for AI-assisted workflows.",
  "main": "main.js",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "check": "node --check main.js",
    "lint": "eslint . --max-warnings 0",
    "review": "node scripts/review-community.mjs",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm run lint && npm run test && npm run build && npm run check && npm run review"
  },
  "keywords": [
    "obsidian",
    "notes",
    "drawing",
    "annotation",
    "ai"
  ],
  "author": "Murat",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "globals": "^17.11.0",
    "obsidian": "^1.8.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  }
}
